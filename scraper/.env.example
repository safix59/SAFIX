# Identifiants compte PRO Utopya — à remplir, ce fichier est ignoré par git
UTOPYA_EMAIL=
UTOPYA_PASSWORD=

# Concurrence (nombre de pages scrapées en parallèle). 3 = bon équilibre.
SCRAPE_CONCURRENCY=3

# Timeout par page (ms)
SCRAPE_TIMEOUT_MS=45000

# Chemins (relatifs au dossier scraper/)
LINKS_FILE=links.json
OUTPUT_FILE=prices.json
AUTH_FILE=auth.json
LOG_DIR=logs
